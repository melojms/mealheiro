# Image tag: a release like 0.1.0 (see GitHub Releases), 0.1 for the latest patch, or latest.
# `make up` builds locally and stamps this version; `make pull-up` pulls ghcr.io/melojms/mealheiro:$VERSION.
VERSION=latest
# Host port the app is published on (ignored with compose.proxy.yaml)
HOST_PORT=7447
# Port the server listens on inside the container; the reverse proxy targets mealheiro:$PORT
PORT=7447
# Host directory holding mealheiro.db and backups/ (must be writable by PUID:PGID)
DATA_LOCATION=./data
PUID=65532
PGID=65532
TZ=Europe/Lisbon
LOG_LEVEL=info
